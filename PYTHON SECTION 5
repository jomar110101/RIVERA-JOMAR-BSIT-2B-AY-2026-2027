def random_menu():
    print_header("THE RANDOM MODULE")
    print("""
1. Set a seed (so results can be repeated)
2. Generate a number with randrange()
3. Generate a number with randint()
4. Pick a random item from a list with choice()
5. Draw several UNIQUE items from a list with sample() (like a lottery)
0. Back to main menu
""")

    choice = safe_input("Enter your choice: ").strip()

    if choice == "1":
        seed_val = get_int("Enter a seed (integer): ")
        random.seed(seed_val)
        print(f"\nSeed set to {seed_val}. Random results will now repeat "
              f"the same sequence each time you use this seed.")

    elif choice == "2":
        start = get_int("Enter the start of the range: ")
        stop = get_int("Enter the stop of the range (exclusive): ")
        try:
            print(f"\nrandrange({start}, {stop}) = {random.randrange(start, stop)}")
        except ValueError:
            print("Invalid range. Make sure start < stop. Skipped.")

    elif choice == "3":
        low = get_int("Enter the lowest value (inclusive): ")
        high = get_int("Enter the highest value (inclusive): ")
        try:
            print(f"\nrandint({low}, {high}) = {random.randint(low, high)}")
        except ValueError:
            print("Invalid range. Make sure low <= high. Skipped.")

    elif choice == "4":
        items_raw = safe_input("Enter a list of items separated by commas: ")
        items = [item.strip() for item in items_raw.split(",") if item.strip()]
        if not items:
            print("\nNo items entered. Skipped.")
        else:
            print(f"\nrandom.choice({items}) = {random.choice(items)}")

    elif choice == "5":
        low = get_int("Enter the lowest number in the lottery pool (e.g. 1): ")
        high = get_int("Enter the highest number in the lottery pool (e.g. 49): ")
        k = get_int("How many UNIQUE numbers should be drawn?: ")
        pool = range(low, high + 1)
        try:
            drawn = random.sample(pool, k)
            print(f"\nrandom.sample(range({low}, {high + 1}), {k}) = {sorted(drawn)}")
        except ValueError:
            print("k cannot be larger than the size of the pool. Skipped.")

    elif choice == "0":
        return

    else:
        print("\nInvalid Choice.")

    pause()

